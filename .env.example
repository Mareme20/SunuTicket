APP_NAME=SunuTicket
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=single
LOG_LEVEL=debug

# Base de données : SQLite par défaut (fichier database/database.sqlite).
# Pour MySQL : DB_CONNECTION=mysql puis renseigner les lignes ci-dessous.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sunuticket
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Emails : "log" écrit les emails dans storage/logs (pour tester). En production, passer à smtp.
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=billets@sunuticket.sn
MAIL_FROM_NAME="${APP_NAME}"

# Frais (en pourcentage du prix du billet / du total payé)
COMMISSION_PERCENT=7
GATEWAY_PERCENT=3
ORDER_HOLD_MINUTES=20
MAX_TICKETS_PER_ORDER=10

# PayDunya : "test" (sandbox) ou "live". Les clés sont dans votre tableau de bord PayDunya > Intégrer.
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=

# Compte administrateur créé par "php artisan db:seed" (changez le mot de passe !)
ADMIN_NAME=Marième
ADMIN_PHONE=770000000
ADMIN_EMAIL=
ADMIN_PASSWORD=changez-moi-vite
